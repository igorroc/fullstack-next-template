{
	"name": "fullstack-next-template",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"overrides": {
		"@babel/runtime": "^7.26.10",
		"brace-expansion": "^5.0.9",
		"braces": "^3.0.3",
		"cross-spawn": "^7.0.5",
		"flatted": "^3.4.0",
		"glob": "^10.5.0",
		"js-yaml": "^4.3.1",
		"micromatch": "^4.0.8",
		"minimatch": "^10.1.1",
		"nanoid": "^3.3.18",
		"picomatch": "^2.3.2",
		"postcss": "^8.5.25",
		"sharp": "^0.35.4",
		"yaml": "^2.8.3"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"check:production": "bun run format:check && bun run lint && bun run ts-check && bun run build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"compose:up": "docker compose up -d",
		"vercel-build": "prisma generate && prisma migrate deploy && next build",
		"migrate": "bunx prisma migrate dev && bunx prisma generate",
		"migrate:reset": "bunx prisma migrate reset --force",
		"migrate:create-only": "bunx prisma migrate dev --create-only",
		"prisma:studio": "bunx prisma studio",
		"security:audit": "bun audit --audit-level=moderate",
		"ts-check": "tsc --noEmit"
	},
	"dependencies": {
		"@heroui/react": "3.2.6",
		"@node-rs/argon2": "2.2.1",
		"@prisma/client": "^5.22.0",
		"framer-motion": "^12.43.0",
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-toastify": "^10.0.6",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"autoprefixer": "^10.6.1",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.3.5",
		"postcss": "^8.5.28",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^5.22.0",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3"
	}
}
