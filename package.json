{
	"name": "fullstack-next-template",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"bun": ">=1.3.14"
	},
	"overrides": {
		"@babel/runtime": "^7.26.10",
		"brace-expansion": "^5.0.8",
		"braces": "^3.0.3",
		"cross-spawn": "^7.0.5",
		"flatted": "^3.4.0",
		"glob": "^10.5.0",
		"micromatch": "^4.0.8",
		"minimatch": "^10.1.1",
		"nanoid": "^3.3.8",
		"picomatch": "^2.3.2",
		"postcss": "^8.5.25",
		"sharp": "^0.35.0",
		"yaml": "^2.8.3"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"compose:up": "docker compose up -d",
		"vercel-build": "prisma generate && prisma migrate deploy && next build",
		"migrate": "bunx prisma migrate dev && bunx prisma generate",
		"migrate:reset": "bunx prisma migrate reset --force",
		"migrate:create-only": "bunx prisma migrate dev --create-only",
		"prisma:studio": "bunx prisma studio",
		"security:audit": "bun audit --audit-level=moderate",
		"ts-check": "tsc --noEmit"
	},
	"dependencies": {
		"@nextui-org/react": "^2.6.11",
		"@node-rs/argon2": "^2.0.2",
		"@prisma/client": "^5.22.0",
		"framer-motion": "^12.43.0",
		"next": "16.2.12",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-toastify": "^10.0.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.5.4",
		"eslint": "^9",
		"eslint-config-next": "16.2.12",
		"postcss": "^8.5.25",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^5.22.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3"
	}
}
